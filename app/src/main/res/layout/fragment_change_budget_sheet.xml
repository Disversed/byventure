<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet_container"
    android:paddingHorizontal="20dp"
    android:paddingTop="24dp"
    android:paddingBottom="32dp">

    <!-- Верхняя панель: Заголовок и кнопка закрытия (крестик) -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Выделенный бюджет"
            android:textAppearance="@style/TextAppearance.App.H2" />

        <ImageButton
            android:id="@+id/btnClose"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_cross" />
    </RelativeLayout>

    <!-- Поле ввода: Сумма -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/relation_level_2">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="10dp"
            android:text="Бюджет поездки"
            android:textAppearance="@style/TextAppearance.App.ButtonText" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/ByVenture.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etReceiptSum"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Сумма, Br"
                android:inputType="numberDecimal" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="10dp"
            android:text="Укажите бюжет, который вы готовы выделить на поездку"
            android:textAppearance="@style/TextAppearance.App.SmallText" />
    </LinearLayout>


    <!-- Кнопка подтверждения -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnChangeBudget"
        style="@style/ByVenture.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Сохранить" />

</LinearLayout>