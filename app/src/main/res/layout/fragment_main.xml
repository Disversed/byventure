<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Прокручиваемый контент -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="24dp">

            <!-- Секция 1: Бюджет за сегодня -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Бюджет за сегодня"
                android:textAppearance="@style/TextAppearance.App.H2"/>

            <com.google.android.material.card.MaterialCardView
                style="@style/ByVenture.CardView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="3">

                    <!-- План -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="План"
                            android:textAppearance="@style/TextAppearance.App.SmallText" />

                        <TextView
                            android:id="@+id/tvBudgetPlanned"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textAppearance="@style/TextAppearance.App.H3"
                            tools:text="-- Br" />
                    </LinearLayout>

                    <!-- Потрачено -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Потрачено"
                            android:textAppearance="@style/TextAppearance.App.SmallText" />

                        <TextView
                            android:id="@+id/tvBudgetSpent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textAppearance="@style/TextAppearance.App.H3"
                            tools:text="-- Br" />
                    </LinearLayout>

                    <!-- Остаток -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Остаток"
                            android:textAppearance="@style/TextAppearance.App.SmallText" />

                        <TextView
                            android:id="@+id/tvBudgetRemaining"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textAppearance="@style/TextAppearance.App.H3"
                            tools:text="-- Br" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Секция 2: Маршрут (Таймлайн) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"
                android:text="Маршрут"
                android:textAppearance="@style/TextAppearance.App.H2" />

            <com.google.android.material.card.MaterialCardView
                style="@style/ByVenture.CardView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <!-- Верхняя точка (текущая) -->
                    <View
                        android:id="@+id/dotFrom"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:background="@drawable/bg_dot"
                        app:layout_constraintTop_toTopOf="@id/tvRouteCurrentTitle"
                        app:layout_constraintBottom_toBottomOf="@id/tvRouteCurrentTitle"
                        app:layout_constraintStart_toStartOf="parent" />

                    <TextView
                        android:id="@+id/tvRouteCurrentTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="8dp"
                        android:textAppearance="@style/TextAppearance.App.Text"
                        app:layout_constraintEnd_toStartOf="@id/tvRouteCurrentTime"
                        app:layout_constraintStart_toEndOf="@id/dotFrom"
                        app:layout_constraintTop_toTopOf="parent"
                        tools:text="Загрузка..." />

                    <TextView
                        android:id="@+id/tvRouteCurrentTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.App.Text"
                        app:layout_constraintBaseline_toBaselineOf="@id/tvRouteCurrentTitle"
                        app:layout_constraintEnd_toEndOf="parent"
                        tools:text="--" />

                    <!-- Соединительная линия таймлайна -->
                    <View
                        android:id="@+id/line"
                        android:layout_width="3dp"
                        android:layout_height="0dp"
                        android:background="@color/trip_point"
                        app:layout_constraintTop_toBottomOf="@id/dotFrom"
                        app:layout_constraintBottom_toTopOf="@id/dotTo"
                        app:layout_constraintStart_toStartOf="@id/dotFrom"
                        app:layout_constraintEnd_toEndOf="@id/dotFrom" />

                    <!-- Нижняя точка (следующая) -->
                    <View
                        android:id="@+id/dotTo"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:background="@drawable/bg_dot_next"
                        app:layout_constraintTop_toTopOf="@id/tvRouteNextTitle"
                        app:layout_constraintBottom_toBottomOf="@id/tvRouteNextTitle"
                        app:layout_constraintStart_toStartOf="parent" />

                    <TextView
                        android:id="@+id/tvRouteNextTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="8dp"
                        android:layout_marginTop="16dp"
                        android:textAppearance="@style/TextAppearance.App.Text"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/tvRouteNextTime"
                        app:layout_constraintStart_toEndOf="@id/dotTo"
                        app:layout_constraintTop_toBottomOf="@id/tvRouteCurrentTitle"
                        tools:text="Загрузка..." />

                    <TextView
                        android:id="@+id/tvRouteNextTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.App.Text"
                        app:layout_constraintBaseline_toBaselineOf="@id/tvRouteNextTitle"
                        app:layout_constraintEnd_toEndOf="parent"
                        tools:text="--" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Секция 3: Билеты (Динамический список через RecyclerView) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"
                android:text="Билеты"
                android:textAppearance="@style/TextAppearance.App.H2" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvTickets"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:itemCount="10"
                tools:listitem="@layout/item_ticket" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Плавающая кнопка (FAB) -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAction"
        style="@style/ByVenture.FloatingActionButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:contentDescription="Добавить трату"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:srcCompat="@drawable/ic_budget"
        app:tint="@android:color/white" />

</androidx.constraintlayout.widget.ConstraintLayout>