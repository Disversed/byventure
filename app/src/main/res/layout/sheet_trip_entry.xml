<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/page_margin_inline">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/relation_level_1"
            android:text="@string/entry_title_add"
            android:textAppearance="@style/TextAppearance.App.H2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageButton
            android:id="@+id/btnClose"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_close"
            android:src="@drawable/ic_cross"
            app:layout_constraintBottom_toBottomOf="@id/tvTitle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tvTitle" />

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabs"
            android:background="@android:color/transparent"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/relation_level_2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTitle"
            app:tabGravity="fill"
            app:tabMode="fixed">

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_booking" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_transport" />
        </com.google.android.material.tabs.TabLayout>

        <!-- название: обычное текстовое поле -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilTitle"
            style="@style/ByVenture.TextInputLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/relation_level_2"
            android:hint="@string/hint_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tabs">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAutofill="no"
                android:inputType="textCapSentences"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.App.Text" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- категория: выпадающий список -->
        <Spinner
            android:id="@+id/spinnerCategory"
            style="@style/ByVenture.Spinner"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_marginTop="@dimen/relation_level_2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tilTitle" />

        <!-- адрес / откуда + время -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilFromAddress"
            style="@style/ByVenture.TextInputLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/relation_level_1"
            android:layout_marginEnd="@dimen/relation_level_1"
            android:hint="@string/hint_address"
            app:layout_constraintEnd_toStartOf="@id/btnFromTime"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/spinnerCategory">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etFromAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAutofill="no"
                android:inputType="textPostalAddress"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.App.Text" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- верхний отступ 5dp компенсирует «выступ» рамки TextInputLayout под плавающий hint -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFromTime"
            style="@style/ByVenture.Button.PickerField"
            android:layout_width="150dp"
            android:layout_height="60dp"
            android:layout_marginTop="5dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tilFromAddress" />

        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/barrierFrom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="tilFromAddress,btnFromTime" />

        <TextView
            android:id="@+id/tvFromTimeError"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="@style/TextAppearance.App.SmallText"
            android:textColor="?attr/colorError"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/barrierFrom" />

        <!-- куда + время (только для билета) -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilToAddress"
            style="@style/ByVenture.TextInputLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/relation_level_1"
            android:layout_marginEnd="@dimen/relation_level_1"
            android:hint="@string/hint_to"
            app:layout_constraintEnd_toStartOf="@id/btnToTime"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvFromTimeError">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etToAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAutofill="no"
                android:inputType="textPostalAddress"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.App.Text" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnToTime"
            style="@style/ByVenture.Button.PickerField"
            android:layout_width="150dp"
            android:layout_height="56dp"
            android:layout_marginTop="5dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tilToAddress" />

        <androidx.constraintlayout.widget.Group
            android:id="@+id/groupTo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:constraint_referenced_ids="tilToAddress,btnToTime" />

        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/barrierTo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="tilToAddress,btnToTime" />

        <TextView
            android:id="@+id/tvToTimeError"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="@style/TextAppearance.App.SmallText"
            android:textColor="?attr/colorError"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/barrierTo" />

        <!-- режим добавления -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAdd"
            style="@style/ByVenture.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginTop="@dimen/relation_level_3"
            android:enabled="false"
            android:text="@string/action_add"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvToTimeError" />

        <!-- режим редактирования -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDelete"
            style="@style/ByVenture.Button.Danger"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginTop="@dimen/relation_level_3"
            android:layout_marginEnd="@dimen/relation_level_1"
            android:text="@string/action_delete"
            app:layout_constraintEnd_toStartOf="@id/btnSave"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvToTimeError" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSave"
            style="@style/ByVenture.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginTop="@dimen/relation_level_3"
            android:enabled="false"
            android:text="@string/action_save"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/btnDelete"
            app:layout_constraintTop_toBottomOf="@id/tvToTimeError" />

        <androidx.constraintlayout.widget.Group
            android:id="@+id/groupEdit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:constraint_referenced_ids="btnDelete,btnSave" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>