<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Когда вкладка выбрана — текст белый -->
    <item android:color="@color/main" android:state_selected="true" />

    <!-- Когда вкладка выключена (disabled) — серый -->
    <item android:color="@color/disabled_text" android:state_enabled="false" />

    <!-- Обычное состояние (Normal) — темный текст -->
    <item android:color="@color/white" />
</selector>