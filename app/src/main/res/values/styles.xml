<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Button -->
    <style name="ByVenture.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">@dimen/border_radius_15</item>
        <item name="android:textAppearance">@style/TextAppearance.App.ButtonText</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- TextInputLayout -->
    <style name="ByVenture.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/border_radius_15</item>
        <item name="boxCornerRadiusTopEnd">@dimen/border_radius_15</item>
        <item name="boxCornerRadiusBottomStart">@dimen/border_radius_15</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/border_radius_15</item>
        <item name="boxStrokeWidth">1.5dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <!--<item name="hintTextAppearance">@style/TextAppearance.App.ButtonText</item>-->
        <item name="android:textAppearance">@style/TextAppearance.App.Text</item>
    </style>

    <!-- BottomNavigationView -->
    <style name="ByVenture.BottomNavigationView" parent="Widget.MaterialComponents.BottomSheet.Modal">
        <item name="itemIconTint">@color/bottom_nav_state_selector</item>
        <item name="itemTextColor">@color/bottom_nav_state_selector</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.App.Title</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.App.Title</item>
        <item name="backgroundColor">@color/md_theme_surfaceContainerLowest_highContrast</item>
        <item name="backgroundTint">@color/md_theme_surfaceContainerLowest_highContrast</item>
        <item name="itemPaddingTop">4dp</item>
    </style>

    <!-- FloatingActionButton -->
    <style name="ByVenture.FloatingActionButton" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="cornerSize">100dp</item>
        <item name="shapeAppearance">@null</item>
    </style>

    <!-- Switch -->
    <style name="ByVenture.Switch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="android:textAppearance">@style/TextAppearance.App.Title</item>
    </style>

    <!-- CheckBox -->
    <style name="ByVenture.CheckBox" parent="Widget.Material3.CompoundButton.CheckBox">
        <!-- <item name="cornerSize">100dp</item> Не понял, как это сделать -->
        <item name="android:textAppearance">@style/TextAppearance.App.Title</item>
    </style>


    <!-- Стили Дмитрия -->
    <style name="ByVenture.TextInputLayout.Dropdown" parent="ByVenture.TextInputLayout">
        <item name="endIconMode">dropdown_menu</item>
    </style>
    <!-- Поле, которое открывает пикер (ввод вручную запрещён) -->
    <style name="ByVenture.PickerEditText" parent="Widget.MaterialComponents.TextInputEditText.OutlinedBox">
        <item name="android:focusable">false</item>
        <item name="android:clickable">true</item>
        <item name="android:cursorVisible">false</item>
        <item name="android:inputType">none</item>
        <item name="android:textAppearance">@style/TextAppearance.App.Text</item>
    </style>
</resources>